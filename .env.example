# ============================================================
# MemorAi Environment Configuration
# ============================================================


# ---------- MySQL ----------

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password

DB_NAME=Memor_ai
DB_POOL_NAME=memorai_pool
DB_POOL_SIZE=5


# ---------- Vision ----------

CAMERA_INDEX=0
YOLO_MODEL_PATH=models/yolo/yolo11s.pt

YOLO_CONFIDENCE=0.45
CONFIRMATION_FRAMES=4
DETECTION_COOLDOWN_SECONDS=8

IMPORTANT_OBJECTS=cell phone,bottle,cup,book,remote,handbag,backpack,keys,scissors


# ---------- ChromaDB / RAG ----------

CHROMA_PATH=chroma_data
CHROMA_COLLECTION_NAME=memorai_memories

EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5

DEFAULT_TOP_K=5
MAX_DISTANCE=1.20


# ---------- Ollama ----------

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b


# ---------- Faster-Whisper ----------

WHISPER_MODEL_SIZE=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8


# ---------- NiceGUI ----------

# Use a long random value in your local .env file.
# Never publish the real value.
MEMORAI_STORAGE_SECRET=replace_with_a_long_random_secret